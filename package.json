{
  "name": "@aller/google-cloud-secret",
  "description": "Concurrent update of google cloud secret",
  "version": "3.0.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "test": "mocha",
    "posttest": "npm run lint && npm run build && npm run test:types && npm run test:md",
    "lint": "eslint . --cache && prettier . -c",
    "test:types": "tsc -p . && tsc -p test",
    "cov:html": "c8 -n src -r html -r text mocha",
    "test:lcov": "c8 -n src -r lcov -r text mocha",
    "test:md": "node --experimental-vm-modules --no-warnings ./scripts/texample-setup.js",
    "build": "dts-buddy && npm run toc",
    "toc": "node ./scripts/toc.js",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./emulator": {
      "types": "./types/index.d.ts",
      "default": "./src/emulator/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "google cloud secret manager",
    "secret",
    "cache",
    "concurrent",
    "update",
    "emulator",
    "mock",
    "grpc"
  ],
  "author": {
    "name": "Aller Media",
    "url": "https://github.com/allermedia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allermedia/google-cloud-secret.git"
  },
  "license": "MIT",
  "overrides": {
    "mocha": {
      "yargs": "^18.1.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google-cloud/secret-manager": "^7.0.0",
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.8.0",
    "@types/debug": "^4.1.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.13",
    "c8": "^12.0.0",
    "chai": "^6.0.1",
    "chronokinesis": "^8.0.0",
    "debug": "^4.4.1",
    "dts-buddy": "^0.8.0",
    "eslint": "^10.4.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "globals": "^17.6.0",
    "lru-cache": "^11.2.1",
    "mocha": "^11.7.1",
    "mocha-cakes-2": "^3.3.0",
    "nock": "^14.0.9",
    "prettier": "^3.6.2",
    "texample": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@google-cloud/secret-manager": ">=6",
    "@grpc/grpc-js": "1.x",
    "@grpc/proto-loader": "0.x",
    "debug": ">=4",
    "long": ">=5",
    "lru-cache": ">=11"
  },
  "files": [
    "src",
    "types/index.d*",
    "CHANGELOG.md"
  ]
}
